# Copy to .env and fill in values.

# API key — if unset, server accepts all requests (dev mode)
# RUBRA_API_KEY=your-secret-key-here

# Database — defaults to SQLite at .rubra/rubra.db
# RUBRA_DATABASE_URL=sqlite:///./data/rubra.db
# RUBRA_DATABASE_URL=postgresql://user:pass@localhost:5432/rubra

# Server
RUBRA_HOST=0.0.0.0
RUBRA_PORT=8000
RUBRA_DEBUG=false

# CORS — restrict to your frontend origin in production
# RUBRA_CORS_ORIGINS=["https://your-app.com"]
RUBRA_CORS_ORIGINS=["*"]
